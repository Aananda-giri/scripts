# OpenAI-compatible API key (works with DeepSeek, OpenAI, etc.)
OPENAI_COMPATIBLE_API_KEY=your-api-key-here

# LLM provider — defaults to DeepSeek
OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Embedding model (loaded locally via sentence-transformers)
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=8

# Optional: reduce CUDA memory fragmentation on GPUs with limited VRAM
# PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_HTTP_PORT=6333
COLLECTION_NAME=job_chunks
