# OpenAI-compatible API key (works with DeepSeek, OpenAI, Ollama, etc.)
OPENAI_COMPATIBLE_API_KEY=your-api-key-here

# LLM provider — defaults to DeepSeek
OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Embedding provider — defaults to local Ollama with nomic-embed-text-v1.5
OPENAI_COMPATIBLE_EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_HTTP_PORT=6333
COLLECTION_NAME=job_chunks
